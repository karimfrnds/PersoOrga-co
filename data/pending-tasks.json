{"items":[{"id":"e5c53726-76df-4f45-8cbb-a14eb860085f","text":"Also der Tim soll morgen also Mittwoch der 26. August die Kaffeemaschine tiefen reinigen außerdem die beiden Mühlen polieren und reinigen die Kühlschränke an der Bar alle mal wischen und im Allgemeinen die Türen und Seitenwände der Bar wischen und mal wenn er Zeit hat die Schubladen und schränke wieder ordentlich machen","assignedToName":null,"createdAt":"2026-08-25T16:46:24.763Z"},{"id":"ba4ac03a-18d8-4785-bf7e-12b51fecdbb0","text":"Vitrine putzen","assignedToName":"Timm","targetDate":null,"priority":"hoch","createdAt":"2026-08-25T16:48:47.860Z"},{"id":"21bd9b06-c3df-42ee-82a5-aba4648829e6","text":"Kasse zählen","assignedToName":"Anna","targetDate":"2026-08-26","priority":"normal","createdAt":"2026-08-25T16:48:47.860Z"},{"id":"717706cd-f75c-423a-946f-913decaaddfe","text":"Kaffeemaschine tiefenreinigen","assignedToName":"Tim","targetDate":"2026-08-26","priority":"normal","createdAt":"2026-08-25T16:48:58.975Z"},{"id":"2d40f4da-9f67-4202-b59e-ebddc3bcaa84","text":"Mühlen polieren und reinigen","assignedToName":"Tim","targetDate":"2026-08-26","priority":"normal","createdAt":"2026-08-25T16:48:58.975Z"},{"id":"cd63260c-dd4f-433f-b60a-b48d7d9cd4d1","text":"Kühlschränke an der Bar wischen","assignedToName":"Tim","targetDate":"2026-08-26","priority":"normal","createdAt":"2026-08-25T16:48:58.975Z"},{"id":"fae4df0e-7819-4dff-a02c-1c4a773cfe61","text":"Türen und Seitenwände der Bar wischen","assignedToName":"Tim","targetDate":"2026-08-26","priority":"normal","createdAt":"2026-08-25T16:48:58.975Z"},{"id":"8158078b-0e31-4e14-8a3d-fa73066c967e","text":"Schubladen und Schränke ordentlich machen","assignedToName":"Tim","targetDate":"2026-08-26","priority":"niedrig","createdAt":"2026-08-25T16:48:58.975Z"}]}